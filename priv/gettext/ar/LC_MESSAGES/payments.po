#, elixir-autogen, elixir-format
msgid "cancelled"
msgstr "ملغاة"

#: lib/udin_billing/web/payments_live.ex
#, elixir-autogen, elixir-format
msgid "failed"
msgstr "فاشلة"

#: lib/udin_billing/web/payments_live.ex
#, elixir-autogen, elixir-format
msgid "needs refund"
msgstr "تحتاج استردادًا"

#: lib/udin_billing/web/payments_live.ex
#, elixir-autogen, elixir-format
msgid "none"
msgstr "لا يوجد"

#: lib/udin_billing/web/payments_live.ex
#, elixir-autogen, elixir-format
msgid "paid"
msgstr "مدفوعة"

#: lib/udin_billing/web/payments_live.ex
#, elixir-autogen, elixir-format
msgid "pending"
msgstr "قيد الانتظار"


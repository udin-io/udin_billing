msgid "Preview language"
msgstr "لغة المعاينة"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Price"
msgstr "السعر"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Recommended"
msgstr "موصى بها"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Renews every"
msgstr "يتجدد كل"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Reset every"
msgstr "يتجدد الرصيد كل"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Save changes"
msgstr "حفظ التغييرات"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Saved %{code}."
msgstr "تم حفظ %{code}."

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Saving applies right away to new buyers. Nothing is charged by saving."
msgstr "الحفظ يسري فورًا على المشترين الجدد. لا يتم تحصيل أي مبلغ بسبب الحفظ."

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Saving creates this plan and takes %{code} off sale. Its buyers keep it until their paid period ends. Give this version its own payment provider product ids."
msgstr "الحفظ ينشئ هذه الباقة ويوقف %{code} عن البيع. يحتفظ مشترو %{code} بها حتى تنتهي مدتهم المدفوعة. أعطِ هذه النسخة معرّفات منتجات خاصة بها عند مزوّد الدفع."

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Saving…"
msgstr "جارٍ الحفظ…"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Subscribers don't get the free plan on top of their plan. This decides what they get when they're back on free."
msgstr "المشتركون لا يحصلون على الباقة المجانية إضافة إلى باقتهم. هذا الاختيار يحدد ما يحصلون عليه عند عودتهم إلى المجانية."

#: lib/udin_billing/web/plan_form.ex
#, elixir-autogen, elixir-format
msgid "Subscription plan"
msgstr "باقة اشتراك"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Switch"
msgstr "ميزة تشغيل أو إيقاف"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "That plan doesn't exist."
msgstr "هذه الباقة غير موجودة."

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "The currency of the price. It can't change once the plan has buyers."
msgstr "عملة السعر. لا يمكن تغييرها بعد أن يشتري الباقة أحد."

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "The id each payment provider knows this plan by. Several ids: separate with commas."

msgid "Plan type"
msgstr "نوع الباقة"

#: lib/udin_billing/web/plan_form_live.ex
#, elixir-autogen, elixir-format
msgid "Preview"
msgstr "معاينة"

#: lib/udin_billing/web/plan_form_live.ex

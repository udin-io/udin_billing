#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "%{place} is missing, or its value is not allowed."
msgstr "%{place} غير موجود أو قيمته غير مسموحة."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "%{place} must be a price written in quotes, like \"150.00\"."
msgstr "%{place} يجب أن يكون سعرًا بين علامتي اقتباس، مثل \"150.00\"."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "%{place} must be an object, written with curly braces."
msgstr "%{place} يجب أن يكون كائنًا مكتوبًا بين أقواس معقوفة."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "%{place} must give a product id, or a list of ids, for each payment provider."
msgstr "%{place} يجب أن يحدد معرّف منتج، أو قائمة معرّفات، لكل مزوّد دفع."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "%{place} must have one text for each language."
msgstr "%{place} يجب أن يحتوي على نص واحد لكل لغة."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Apply changes"
msgstr "تطبيق التغييرات"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Apply changes the real plans and features of this environment, and buyers can see them. It is all or nothing: if one change fails, nothing is saved. It can't be undone with one click."
msgstr "التطبيق يغيّر الباقات والميزات الفعلية في هذه البيئة ويراها المشترون. إما أن يتم كل شيء أو لا يتم شيء: إذا فشل تغيير واحد لا يُحفظ أي شيء. ولا يمكن التراجع عنه بضغطة واحدة."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Apply these changes to this environment? It can't be undone with one click."
msgstr "هل تريد تطبيق هذه التغييرات على هذه البيئة؟ لا يمكن التراجع عنها بضغطة واحدة."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Catalog applied: %{count} change."
msgid_plural "Catalog applied: %{count} changes."
msgstr[0] "تم تطبيق الكتالوج: لا تغييرات"
msgstr[1] "تم تطبيق الكتالوج: تغيير واحد"
msgstr[2] "تم تطبيق الكتالوج: تغييران"
msgstr[3] "تم تطبيق الكتالوج: %{count} تغييرات"
msgstr[4] "تم تطبيق الكتالوج: %{count} تغييرًا"
msgstr[5] "تم تطبيق الكتالوج: %{count} تغيير"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Catalog file (JSON)"
msgstr "ملف الكتالوج (JSON)"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Change"
msgstr "التغيير"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Couldn't export: %{reason}"
msgstr "تعذّر التصدير: %{reason}"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Create adds something new. Update changes something that already exists here."
msgstr "إنشاء يضيف شيئًا جديدًا. تحديث يغيّر شيئًا موجودًا هنا بالفعل."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Export"
msgstr "تصدير"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Exported catalog file"
msgstr "ملف الكتالوج المُصدَّر"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Feature %{key} is a %{current} here and can't become a %{wanted}."
msgstr "الميزة %{key} من نوع %{current} هنا ولا يمكن أن تصبح من نوع %{wanted}."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Feature %{key} is needed by the app's code, but it is in neither the file nor this environment."
msgstr "الميزة %{key} يحتاجها كود التطبيق، لكنها ليست في الملف ولا في هذه البيئة."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Fields"
msgstr "الحقول"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "For example: this environment has the plan %{plan_code} and one more plan, and the file only has %{plan_code}. With this on, the other plan goes off sale."
msgstr "مثال: في هذه البيئة الباقة %{plan_code} وباقة أخرى، والملف فيه %{plan_code} فقط. مع تشغيل هذا الخيار تتوقف الباقة الأخرى عن البيع."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Import"
msgstr "استيراد"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "In this environment but not in the file: %{plans}. They are kept as they are."
msgstr "موجودة في هذه البيئة وليست في الملف: %{plans}. تبقى كما هي."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "In this environment but not in the file: %{plans}. They will be taken off sale."
msgstr "موجودة في هذه البيئة وليست في الملف: %{plans}. سيتوقف بيعها."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Item"
msgstr "العنصر"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Leave this off if you only want to add or update plans. Turn it on only when the file is the complete list of plans you want on sale here."
msgstr "اتركه مطفأً إذا أردت فقط إضافة الباقات أو تحديثها. شغّله فقط عندما يكون الملف هو القائمة الكاملة للباقات التي تريد عرضها للبيع هنا."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Nothing can be applied until these are fixed:"
msgstr "لا يمكن تطبيق شيء قبل إصلاح هذه المشكلات:"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Or make the file with this command:"
msgstr "أو أنشئ الملف بهذا الأمر:"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Paste a catalog file from another environment, preview what changes here, then apply it."
msgstr "الصق ملف كتالوج من بيئة أخرى، وشاهد ما سيتغير هنا، ثم طبّقه."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Paste the whole file. It is the text from the Export box of the other environment. For example: a file with the plan %{plan_code} adds that plan here if it is new, or updates it if it exists."
msgstr "الصق الملف كاملًا. هو النص الموجود في صندوق التصدير في البيئة الأخرى. مثال: ملف فيه الباقة %{plan_code} يضيف هذه الباقة هنا إذا كانت جديدة، أو يحدّثها إذا كانت موجودة."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Plans and features are matched by plan code and feature key. Nothing is ever deleted."
msgstr "تتم مطابقة الباقات بالمعرّف والميزات بالمفتاح. لا يُحذف أي شيء أبدًا."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Preview changes"
msgstr "معاينة التغييرات"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Preview is a dry run. It checks the file and shows what would change, but it saves nothing."
msgstr "المعاينة تجربة بلا حفظ. تفحص الملف وتعرض ما سيتغير، لكنها لا تحفظ شيئًا."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Set up features and plans once, then move them to another environment as one file, for example from staging to production, instead of entering them again."
msgstr "جهّز الميزات والباقات مرة واحدة، ثم انقلها إلى بيئة أخرى في ملف واحد، مثل النقل من بيئة التجربة إلى بيئة التشغيل، بدل إدخالها من جديد."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "Take plans that aren't in the file off sale (buyers keep them)"
msgstr "أوقف بيع الباقات التي ليست في الملف (يحتفظ بها المشترون)"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "The file is not valid JSON: %{detail}"
msgstr "الملف ليس JSON صالحًا: %{detail}"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "This catalog file version %{version} is not supported. The supported version is %{supported}."
msgstr "إصدار ملف الكتالوج %{version} غير مدعوم. الإصدار المدعوم هو %{supported}."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "This environment already matches the file."
msgstr "هذه البيئة مطابقة للملف بالفعل."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "This environment's features and plans. Copy this text and paste it into the Import box of another environment."
msgstr "ميزات هذه البيئة وباقاتها. انسخ هذا النص والصقه في صندوق الاستيراد في بيئة أخرى."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "This is not a billing catalog file. It must contain \"format\": \"%{format}\"."
msgstr "هذا ليس ملف كتالوج فوترة. يجب أن يحتوي على \"format\": \"%{format}\"."

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "To keep it with your code, save it as this file and commit it:"
msgstr "للاحتفاظ به مع الكود، احفظه بهذا الاسم وأضفه إلى المستودع:"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "What will change"
msgstr "ما الذي سيتغير"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "create"
msgstr "إنشاء"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "feature"
msgstr "ميزة"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "plan"
msgstr "باقة"

#: lib/udin_billing/web/catalog_live.ex
#, elixir-autogen, elixir-format
msgid "update"
msgstr "تحديث"
